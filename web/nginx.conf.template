# Forvia — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API → backend container
    location /api/ {
        # nginx's own default (1m) is well under a base64-encoded photo — every upload past
        # roughly 700KB was hitting nginx's 413 (an HTML page, not JSON) before ever reaching
        # the backend's own, friendlier size check. Match the backend's MAX_BODY headroom.
        client_max_body_size 9m;
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Real-time push to an already-open app (api/server.js's WebSocket server) — its own
    # location, not under /api/, since a WS upgrade needs Upgrade/Connection headers the plain
    # HTTP proxy block above doesn't send. proxy_read_timeout is raised well past nginx's 60s
    # default: the app pings every 25s so this shouldn't matter in practice, but a proxy timeout
    # racing the app's own keepalive would just be a second, redundant way to drop the same
    # connection for no reason.
    location /ws {
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
